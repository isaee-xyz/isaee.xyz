# Security hardening for isaee.xyz (Hostinger / LiteSpeed — Apache-compatible)

# ---------- Security headers ----------
<IfModule mod_headers.c>
  # Force HTTPS for a year on returning visitors (Hostinger already 301s HTTP->HTTPS)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Stop MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Disallow embedding in iframes (clickjacking)
  Header always set X-Frame-Options "DENY"

  # Don't leak full URLs to third parties
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # This site needs none of these browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Content Security Policy — allowlist exactly what the built site uses:
  #   scripts: bundled JS only; styles: bundle + Google Fonts CSS;
  #   fonts: gstatic; img: self + data-URI favicon + Amazon book cover;
  #   connect: Gemini API (chat widget, only if a key is configured)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://m.media-amazon.com; connect-src 'self' https://generativelanguage.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

# ---------- Block hidden/sensitive files ----------
# Return 404 (not 403) for dotfiles and env/config leftovers so their existence isn't confirmed
RedirectMatch 404 (?i)/\.(?!well-known/)
RedirectMatch 404 (?i)\.(env|bak|config|sql|log|sh|ini|lock)$

# Disable directory listings
Options -Indexes

# ---------- Caching (hashed assets immutable, HTML always revalidated) ----------
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Blog assets have readable filenames; revalidate so editorial fixes appear promptly.
<IfModule mod_headers.c>
  <FilesMatch "^(explainer\.(js|css)|library\.css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
